{
	"extends": "@tsconfig/svelte/tsconfig.json",
	"compilerOptions": {
		"target": "ESNext",
		"skipLibCheck": true,
		"erasableSyntaxOnly": true,
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"strict": true,
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"types": ["vite/client"],
	},
	"include": ["src/**/*.ts", "src/**/*.svelte"],
}
